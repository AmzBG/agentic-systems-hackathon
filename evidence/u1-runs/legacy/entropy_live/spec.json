{
 "controls": [
  {
   "id": "n_outcomes",
   "label": "Number of outcomes",
   "help": "Sets how many outcomes are active; changing it changes Weights sum, the number of entries in Probabilities and Contributions, and Entropy.",
   "units": "unitless",
   "kind": "slider",
   "default": 4,
   "min": 2,
   "max": 6,
   "step": 1
  },
  {
   "id": "weights",
   "label": "Weights",
   "help": "Editable weights w_i; raising one weight against the others raises its Probability and its Contribution and lowers Entropy while Concentration stays at 1.",
   "units": "unitless",
   "kind": "vector",
   "default": [
    1,
    1,
    1,
    1,
    0,
    0
   ],
   "min": 0,
   "max": 10,
   "step": 0.5,
   "shape": [
    6
   ]
  },
  {
   "id": "concentration",
   "label": "Concentration",
   "help": "Blends Probabilities between uniform at 0 and the normalized weights at 1; it changes every Probability, every Contribution and Entropy.",
   "units": "unitless",
   "kind": "slider",
   "default": 1,
   "min": 0,
   "max": 1,
   "step": 0.05
  }
 ],
 "outputs": [
  {
   "id": "weights_sum",
   "label": "Weights sum S",
   "units": "unitless",
   "role": "intermediate"
  },
  {
   "id": "probabilities",
   "label": "Probabilities p_i",
   "units": "unitless",
   "role": "intermediate"
  },
  {
   "id": "contributions",
   "label": "Contributions -p_i log2 p_i",
   "units": "bits",
   "role": "intermediate"
  },
  {
   "id": "entropy",
   "label": "Entropy H",
   "units": "bits",
   "role": "result"
  }
 ],
 "visuals": [
  {
   "id": "prob_bar",
   "kind": "bar",
   "title": "Probability of each active outcome",
   "output": "probabilities",
   "x_label": "Outcome index i",
   "y_label": "Probability p_i (unitless)"
  },
  {
   "id": "contrib_bar",
   "kind": "bar",
   "title": "Contribution of each outcome to entropy",
   "output": "contributions",
   "x_label": "Outcome index i",
   "y_label": "Contribution -p_i log2 p_i (bits)"
  },
  {
   "id": "entropy_line",
   "kind": "line",
   "title": "Entropy against concentration",
   "output": "entropy",
   "x_label": "Concentration c (unitless)",
   "y_label": "Entropy H (bits)",
   "sweep": {
    "control": "concentration",
    "min": 0,
    "max": 1,
    "points": 21
   }
  }
 ],
 "explorations": [
  {
   "title": "Certainty silences every contribution",
   "instruction": "Predict: what happens to Entropy when one outcome has weight 1 and the remaining outcomes have weight 0. Then apply the preset, which sets Number of outcomes to 4, Weights to [1,0,0,0,0,0] and Concentration to 1.",
   "observe": "Probabilities becomes 1, 0, 0, 0; every Contribution is 0; Entropy reads 0 bits while Weights sum stays 1.",
   "why": "Only the certain outcome has nonzero probability, and the term -p log2 p vanishes both for p equal to 1 and for p equal to 0, so the sum of Contributions is zero and the outcome carries no choice.",
   "preset": {
    "n_outcomes": 4,
    "weights": [
     1,
     0,
     0,
     0,
     0,
     0
    ],
    "concentration": 1
   }
  },
  {
   "title": "More equally likely outcomes add bits",
   "instruction": "Predict: how Entropy changes when the number of equally likely outcomes grows from 4 to 6. Then apply the preset, which sets Number of outcomes to 6, Weights to [1,1,1,1,1,1] and Concentration to 1.",
   "observe": "Weights sum becomes 6, each Probability is about 0.1667, each Contribution is about 0.4308 bits, and Entropy rises from 2 bits to about 2.585 bits.",
   "why": "For n equally likely outcomes each Contribution equals log2 n divided by n, and n copies of that value sum to log2 n, so Entropy grows as the base-2 logarithm of the number of outcomes.",
   "preset": {
    "n_outcomes": 6,
    "weights": [
     1,
     1,
     1,
     1,
     1,
     1
    ],
    "concentration": 1
   }
  }
 ],
