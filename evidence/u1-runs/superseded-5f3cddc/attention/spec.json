{
 "controls": [
  {
   "id": "q_mat",
   "label": "Query matrix Q (3 queries x 2 dims)",
   "help": "Changing Q changes the similarity scores (scores), which changes the attention weights (weights) and the final output.",
   "units": "unitless",
   "kind": "matrix",
   "default": [
    [
     1,
     0
    ],
    [
     0,
     1
    ],
    [
     1,
     1
    ]
   ],
   "min": -4,
   "max": 4,
   "step": 0.5,
   "shape": [
    3,
    2
   ]
  },
  {
   "id": "k_mat",
   "label": "Key matrix K (3 keys x 2 dims)",
   "help": "Changing K changes the similarity scores (scores), which changes the attention weights (weights) and the final output.",
   "units": "unitless",
   "kind": "matrix",
   "default": [
    [
     1,
     0
    ],
    [
     0,
     1
    ],
    [
     1,
     1
    ]
   ],
   "min": -4,
   "max": 4,
   "step": 0.5,
   "shape": [
    3,
    2
   ]
  },
  {
   "id": "v_mat",
   "label": "Value matrix V (3 values x 2 dims)",
   "help": "Changing V changes the final output (output) because output is a weighted average of V rows, but it does not change scores or weights.",
   "units": "unitless",
   "kind": "matrix",
   "default": [
    [
     1,
     0
    ],
    [
     0,
     1
    ],
    [
     1,
     0
    ]
   ],
   "min": -4,
   "max": 4,
   "step": 0.5,
   "shape": [
    3,
    2
   ]
  },
  {
   "id": "scale_on",
   "label": "Scale scores by 1/sqrt(d_k)",
   "help": "Turning scaling off leaves scores unscaled, which changes the attention weights (weights) and the final output; turning it on divides scores by sqrt(2).",
   "units": "unitless",
   "kind": "toggle",
   "default": true
  }
 ],
 "outputs": [
  {
   "id": "scores",
   "label": "Similarity scores s_ij",
   "units": "unitless",
   "role": "intermediate"
  },
  {
   "id": "weights",
   "label": "Attention weights a_ij",
   "units": "unitless",
   "role": "intermediate"
  },
  {
   "id": "row_sums",
   "label": "Row sums r_i of attention weights",
   "units": "unitless",
   "role": "intermediate"
  },
  {
   "id": "output",
   "label": "Attention output o_ic",
   "units": "unitless",
   "role": "result"
  }
 ],
 "visuals": [
  {
   "id": "scores_heatmap",
   "kind": "heatmap",
   "title": "Similarity scores QK^T / sqrt(d_k)",
   "output": "scores",
   "x_label": "Key index j",
   "y_label": "Query index i"
  },
  {
   "id": "weights_heatmap",
   "kind": "heatmap",
   "title": "Attention weights (softmax of scores)",
   "output": "weights",
   "x_label": "Key index j",
   "y_label": "Query index i"
  },
  {
   "id": "row_sums_bar",
   "kind": "bar",
   "title": "Row sums of attention weights",
   "output": "row_sums",
   "x_label": "Query index i",
   "y_label": "Weight sum",
   "labels": [
    "query 0",
    "query 1",
    "query 2"
   ]
  },
  {
   "id": "output_values",
   "kind": "values",
   "title": "Attention output (weighted sum of values)",
   "output": "output",
   "x_label": "Value dimension c",
   "y_label": "Query index i"
  }
 ],
 "explorations": [
  {
   "title": "Equal keys give uniform attention",
   "instruction": "Predict: when all three keys are identical and all queries are identical, will the three attention weights per query be equal or different? Then apply the preset, which sets q_mat and k_mat to identical rows and leaves scaling on.",
   "observe": "The weights heatmap shows every row equal to about 1/3, the row_sums_bar shows each row sum exactly 1, and output is the average of the three value rows.",
   "why": "Identical keys make every dot product equal, so the softmax of equal scores produces uniform weights 1/3; scaling changes the common score value but not the equality, so the weights stay uniform.",
   "preset": {
    "q_mat": [
     [
      1,
      0
     ],
     [
      1,
      0
     ],
     [
      1,
      0
     ]
    ],
    "k_mat": [
     [
      1,
      0
     ],
     [
      1,
      0
     ],
     [
      1,
      0
     ]
    ],
    "scale_on": true
   }
  },
  {
   "title": "One dominant score concentrates attention",
   "instruction": "Predict: when one query-key dot product is much larger than the other two, will the attention weights stay spread out or concentrate on that key? Then apply the preset, which sets q_mat and k_mat to create a dominant score and turns scaling off.",
   "observe": "The weights heatmap shows the first column near 0.965 and the other columns near 0.018, the row_sums_bar still shows each row sum 1, and output is close to the first value row [1, 0].",
   "why": "A score of 4 makes its exponential much larger than the exponentials of 0, so softmax concentrates almost all weight on that key; turning scaling off keeps the score at 4 instead of 4/sqrt(2).",
   "preset": {
    "q_mat": [
     [
      2,
      0
     ],
     [
      2,
      0
     ],
     [
      2,
      0
     ]
    ],
    "k_mat": [
     [
      2,
      0
     ],
     [
      0,
      1
     ],
     [
      0,
      0
     ]
    ],
    "v_mat": [
     [
      1,
      0
     ],
     [
      0,
      1
     ],
     [
      0,
      0
     ]
    ],
    "scale_on": false
   }
  }
 ],
