{
 "controls": [
  {
   "id": "q",
   "label": "Query matrix Q",
   "help": "Changes Scaled dot-product scores and downstream Attention weights and Attention output; editing a row changes that query's attention.",
   "units": "unitless",
   "kind": "matrix",
   "default": [
    [
     1,
     0
    ],
    [
     0,
     1
    ]
   ],
   "min": -5,
   "max": 5,
   "step": 1,
   "shape": [
    2,
    2
   ]
  },
  {
   "id": "k",
   "label": "Key matrix K",
   "help": "Changes Scaled dot-product scores and downstream Attention weights and Attention output.",
   "units": "unitless",
   "kind": "matrix",
   "default": [
    [
     1,
     0
    ],
    [
     0,
     1
    ]
   ],
   "min": -5,
   "max": 5,
   "step": 1,
   "shape": [
    2,
    2
   ]
  },
  {
   "id": "v",
   "label": "Value matrix V",
   "help": "Changes only the Attention output (through the weighted sum); Scaled dot-product scores and Attention weights stay the same.",
   "units": "unitless",
   "kind": "matrix",
   "default": [
    [
     1,
     2
    ],
    [
     3,
     4
    ]
   ],
   "min": -5,
   "max": 5,
   "step": 1,
   "shape": [
    2,
    2
   ]
  },
  {
   "id": "scaling_on",
   "label": "Apply 1/sqrt(d_k) scaling",
   "help": "When on, divides Scaled dot-product scores by sqrt(d_k)=1.414; when off, uses raw dot products, changing the sharpness of Attention weights and the Attention output.",
   "units": "unitless",
   "kind": "toggle",
   "default": true
  }
 ],
 "outputs": [
  {
   "id": "scores",
   "label": "Scaled dot-product scores",
   "units": "unitless",
   "role": "intermediate"
  },
  {
   "id": "weights",
   "label": "Attention weights",
   "units": "unitless",
   "role": "intermediate"
  },
  {
   "id": "row_sums",
   "label": "Row sums of weights",
   "units": "unitless",
   "role": "intermediate"
  },
  {
   "id": "output",
   "label": "Attention output",
   "units": "unitless",
   "role": "result"
  }
 ],
 "visuals": [
  {
   "id": "viz_scores",
   "kind": "heatmap",
   "title": "Scaled dot-product scores",
   "output": "scores",
   "x_label": "Key index j",
   "y_label": "Query index i"
  },
  {
   "id": "viz_weights",
   "kind": "heatmap",
   "title": "Attention weights (softmax rows)",
   "output": "weights",
   "x_label": "Key index j",
   "y_label": "Query index i"
  },
  {
   "id": "viz_row_sums",
   "kind": "bar",
   "title": "Row sums of attention weights",
   "output": "row_sums",
   "x_label": "Query index i",
   "y_label": "Sum of weights",
   "labels": [
    "query 0",
    "query 1"
   ]
  },
  {
   "id": "viz_output",
   "kind": "values",
   "title": "Attention output",
   "output": "output",
   "x_label": "Value dimension",
   "y_label": "Entry value",
   "labels": [
    "query 0",
    "query 1"
   ]
  }
 ],
 "explorations": [
  {
   "title": "Equal scores give uniform weights",
   "instruction": "Predict: if every query has the same dot product with every key, what will the Attention weights be? Then apply the preset, which sets Query matrix Q to all zeros and Key matrix K to the identity.",
   "observe": "Scaled dot-product scores are all 0, Attention weights become [[0.5,0.5],[0.5,0.5]], Row sums of weights stay [1,1], and Attention output becomes the average of the value rows, [[2,3],[2,3]].",
   "why": "The softmax of equal scores returns the uniform distribution 1/n for each query, so each output is the simple average of the rows of V.",
   "preset": {
    "q": [
     [
      0,
      0
     ],
     [
      0,
      0
     ]
    ],
    "k": [
     [
      1,
      0
     ],
     [
      0,
      1
     ]
    ],
    "v": [
     [
      1,
      2
     ],
     [
      3,
      4
     ]
    ],
    "scaling_on": true
   }
  },
  {
   "title": "Scaling changes sharpness of weights",
   "instruction": "Predict: with a large dot product, does turning scaling off make the Attention weights more or less concentrated? Then apply the preset, which sets scaling off and uses Q and K that give a large score.",
   "observe": "With scaling off, Scaled dot-product scores are [[3,0],[0,3]] and Attention weights row 0 is approximately [0.9526,0.0474], much more peaked than the scaled version; Row sums of weights remain 1, and Attention output shifts toward the matching value row.",
   "why": "Without the 1/sqrt(d_k) divisor, larger logits push the softmax toward one-hot-like values, shrinking gradients; scaling by 1/sqrt(d_k) tempers the logits so the distribution stays softer.",
   "preset": {
    "q": [
     [
      3,
      0
     ],
     [
      0,
      3
     ]
    ],
    "k": [
     [
      1,
      0
     ],
     [
      0,
      1
     ]
    ],
    "v": [
     [
      1,
      0
     ],
     [
      0,
      1
     ]
    ],
    "scaling_on": false
   }
  }
 ],
 "tests": [
