{
 "controls": [
  {
   "id": "q_matrix",
   "label": "Query matrix Q",
   "help": "Changes the queries; each row alters the matching row of Dot products QK^T, Scaled scores, Attention weights, and Attention output.",
   "units": "unitless",
   "kind": "matrix",
   "default": [
    [
     1,
     0
    ],
    [
     0,
     1
    ]
   ],
   "min": -3,
   "max": 3,
   "step": 0.5,
   "shape": [
    2,
    2
   ]
  },
  {
   "id": "k_matrix",
   "label": "Key matrix K",
   "help": "Changes the keys; each row alters one column of Dot products QK^T and Scaled scores, and changes the Attention weights and Attention output.",
   "units": "unitless",
   "kind": "matrix",
   "default": [
    [
     1,
     0
    ],
    [
     0,
     1
    ],
    [
     1,
     1
    ]
   ],
   "min": -3,
   "max": 3,
   "step": 0.5,
   "shape": [
    3,
    2
   ]
  },
  {
   "id": "v_matrix",
   "label": "Value matrix V",
   "help": "Changes the values; each row alters one term in the weighted sum that forms the Attention output.",
   "units": "unitless",
   "kind": "matrix",
   "default": [
    [
     1,
     0
    ],
    [
     0,
     1
    ],
    [
     1,
     1
    ]
   ],
   "min": -3,
   "max": 3,
   "step": 0.5,
   "shape": [
    3,
    2
   ]
  },
  {
   "id": "scaling_enabled",
   "label": "Scaling toggle",
   "help": "Switches the 1/sqrt(d_k) divisor on or off, changing every Scaled score, Attention weight, and Attention output entry.",
   "units": "unitless",
   "kind": "toggle",
   "default": true
  }
 ],
 "outputs": [
  {
   "id": "dot_products",
   "label": "Dot products QK^T",
   "units": "unitless",
   "role": "intermediate"
  },
  {
   "id": "scaled_scores",
   "label": "Scaled scores",
   "units": "unitless",
   "role": "intermediate"
  },
  {
   "id": "attention_weights",
   "label": "Attention weights",
   "units": "unitless",
   "role": "intermediate"
  },
  {
   "id": "weight_row_sums",
   "label": "Weight row sums",
   "units": "unitless",
   "role": "intermediate"
  },
  {
   "id": "attention_output",
   "label": "Attention output",
   "units": "unitless",
   "role": "result"
  }
 ],
 "visuals": [
  {
   "id": "weights_heatmap",
   "kind": "heatmap",
   "title": "Attention weights",
   "output": "attention_weights",
   "x_label": "Key index",
   "y_label": "Query index"
  },
  {
   "id": "output_heatmap",
   "kind": "heatmap",
   "title": "Attention output",
   "output": "attention_output",
   "x_label": "Value dimension",
   "y_label": "Query index"
  },
  {
   "id": "rowsum_bar",
   "kind": "bar",
   "title": "Weight row sums",
   "output": "weight_row_sums",
   "x_label": "Query index",
   "y_label": "Row sum"
  }
 ],
 "explorations": [
  {
   "title": "Equal keys give uniform weights",
   "instruction": "Predict: when all keys are identical, how will the attention weights for a query compare across keys? Then apply the preset, which sets the K matrix.",
   "observe": "The Attention weights heatmap shows every entry equal to about 0.333, and the Weight row sums bar reads 1.000 for both queries.",
   "why": "Identical keys produce identical dot products for a given query, so the softmax exponentials are equal and each of the three weights is one third; normalization makes each row sum one.",
   "preset": {
    "k_matrix": [
     [
      1,
      1
     ],
     [
      1,
      1
     ],
     [
      1,
      1
     ]
    ]
   }
  },
  {
   "title": "Scaling down a dominant score",
   "instruction": "Predict: if one key has a much larger dot product, will turning off the 1/sqrt(d_k) scaling make its attention weight larger or smaller? Then apply the preset, which sets the K matrix and the Scaling toggle.",
   "observe": "With scaling off, the largest Attention weight in a query row rises to about 0.95 from about 0.88 when scaling is on, while the Weight row sums stay at 1.000.",
   "why": "Removing the 1/sqrt(d_k) divisor multiplies the scores by sqrt(2), so the largest score is farther ahead of the others and softmax concentrates more weight on it.",
   "preset": {
    "k_matrix": [
     [
      3,
      0
     ],
     [
      0,
      3
     ],
     [
      -3,
      -3
     ]
    ],
    "scaling_enabled": false
   }
  }
 ],
 "tests": [
  {
   "name": "equal keys uniform weights",
   "inputs": {
    "q_matrix": [
     [
      1,
      0
     ],
     [
      0,
      1
     ]
    ],
    "k_matrix": [
     [
      1,
      1
     ],
     [
      1,
      1
     ],
     [
      1,
      1
     ]
    ],
    "v_matrix": [
     [
      1,
      0
     ],
     [
      0,
      1
     ],
     [
      1,
      1
     ]
    ],
    "scaling_enabled": true
   },
   "expected": {
    "attention_weights": [
     [
      0.3333333333333333,
      0.3333333333333333,
      0.3333333333333333
     ],
     [
      0.3333333333333333,
      0.3333333333333333,
      0.3333333333333333
     ]
    ],
    "weight_row_sums": [
     1,
     1
    ]
   },
   "atol": 1e-09,
   "rtol": 1e-09
  },
  {
   "name": "zero queries give uniform weights",
   "inputs": {
    "q_matrix": [
     [
      0,
      0
     ],
     [
      0,
      0
     ]
    ],
    "k_matrix": [
     [
      1,
      0
     ],
     [
      0,
      1
     ],
     [
      1,
      1
     ]
    ],
    "v_matrix": [
     [
      1,
      0
     ],
     [
      0,
      1
     ],
     [
      1,
      1
     ]
    ],
    "scaling_enabled": true
   },
   "expected": {
    "dot_products": [
     [
      0,
      0,
      0
     ],
     [
      0,
      0,
      0
     ]
    ],
    "scaled_scores": [
     [
      0,
      0,
      0
     ],
     [
      0,
      0,
      0
     ]
    ],
    "attention_weights": [
     [
      0.3333333333333333,
      0.3333333333333333,
      0.3333333333333333
     ],
     [
      0.3333333333333333,
      0.3333333333333333,
      0.3333333333333333
     ]
    ],
    "weight_row_sums": [
     1,
     1
    ]
   },
   "atol": 1e-09,
   "rtol": 1e-09
  },
  {
   "name": "scaling divides dot products by sqrt dk",
   "inputs": {
    "q_matrix": [
     [
      1,
      0
     ],
     [
      0,
      1
     ]
    ],
    "k_matrix": [
     [
      1,
      0
     ],
     [
      0,
      1
     ],
     [
      0,
      0
     ]
    ],
    "v_matrix": [
     [
      1,
      0
     ],
     [
      0,
      1
     ],
     [
