 "explorations": [
  {
   "title": "Scaling sharpens or softens the weights",
   "instruction": "Predict: does removing the 1/sqrt(d_k) divisor sharpen the attention weights? Then apply the preset, which sets the scale toggle off and replaces Q and K.",
   "observe": "The weights A become sharper: the larger entry of each row grows and the smaller shrinks, so the output O moves closer to the value row selected by the dominant score. The row sums stay at 1.",
   "why": "Removing the divisor makes the scaled scores S_scaled larger in magnitude, so the softmax in A saturates toward a one-hot pattern, and the weighted average O follows that shift.",
   "preset": {
    "scale": false,
    "q": [
     [
      2,
      0
     ],
     [
      0,
      2
     ]
    ],
    "k": [
     [
      2,
      0
     ],
     [
      0,
      1
     ]
    ]
   }
  },
  {
   "title": "One dominant score gives a near one-hot weight row",
   "instruction": "Predict: what happens to A and O when one query-key dot product dwarfs the other? Then apply the preset, which sets Q and K and turns scaling off.",
   "observe": "Each row of A is close to one-hot, so the row sums remain 1 and the output O is nearly the value row of the attended key.",
   "why": "A very large score dominates the softmax, so almost all weight lands on one key and the output O is carried by the matching value row.",
   "preset": {
    "scale": false,
    "q": [
     [
      5,
      0
     ],
     [
      0,
      5
     ]
    ],
    "k": [
     [
      5,
      0
     ],
     [
      0,
      5
     ]
    ]
   }
  }
 ],
