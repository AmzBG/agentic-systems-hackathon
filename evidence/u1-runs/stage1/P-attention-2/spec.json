{
 "controls": [
  {
   "id": "q",
   "label": "Query matrix Q",
   "help": "Each entry changes the raw scores S, the scaled scores S_scaled, the weights A, the row sums and the output O.",
   "units": "unitless",
   "kind": "matrix",
   "default": [
    [
     1,
     1
    ],
    [
     1,
     1
    ]
   ],
   "min": -5,
   "max": 5,
   "step": 0.5,
   "shape": [
    2,
    2
   ]
  },
  {
   "id": "k",
   "label": "Key matrix K",
   "help": "Each entry changes the raw scores S, the scaled scores S_scaled, the weights A, the row sums and the output O.",
   "units": "unitless",
   "kind": "matrix",
   "default": [
    [
     1,
     0
    ],
    [
     0,
     1
    ]
   ],
   "min": -5,
   "max": 5,
   "step": 0.5,
   "shape": [
    2,
    2
   ]
  },
  {
   "id": "v",
   "label": "Value matrix V",
   "help": "Each entry changes only the output O, because V is combined after the weights A are fixed.",
   "units": "unitless",
   "kind": "matrix",
   "default": [
    [
     1,
     0
    ],
    [
     0,
     1
    ]
   ],
   "min": -5,
   "max": 5,
   "step": 0.5,
   "shape": [
    2,
    2
   ]
  },
  {
   "id": "scale",
   "label": "Scale scores by 1/sqrt(d_k)",
   "help": "Turning scaling off removes the division from S_scaled, which changes the weights A, the row sums and the output O.",
   "units": "unitless",
   "kind": "toggle",
   "default": true
  }
 ],
 "outputs": [
  {
   "id": "raw_scores",
   "label": "Raw scores S = Q K transpose",
   "units": "unitless",
   "role": "intermediate"
  },
  {
   "id": "scaled_scores",
   "label": "Scaled scores S_scaled",
   "units": "unitless",
   "role": "intermediate"
  },
  {
   "id": "weights",
   "label": "Attention weights A = softmax(S_scaled)",
   "units": "unitless",
   "role": "intermediate"
  },
  {
   "id": "row_sums",
   "label": "Weight row sums",
   "units": "unitless",
   "role": "intermediate"
  },
  {
   "id": "output",
   "label": "Attention output O = A V",
   "units": "unitless",
   "role": "result"
  }
 ],
